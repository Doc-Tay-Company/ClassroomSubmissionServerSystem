        "problem_kind": "java_reflection",
        "sample_source": "package model;\n\npublic class Rectangle implements Comparable<Rectangle> {\n    private double width;\n    private double height;\n\n    public Rectangle(double width, double height) { this.width = width; this.height = height; }\n\n    public double getArea() { return width * height; }\n\n    public void setWidth(double width) {\n        if (width < 0) throw new IllegalArgumentException(\"width\");\n        this.width = width;\n    }\n\n    @Override public String toString() { return \"Rectangle{width=\" + width + \", height=\" + height + \"}\"; }\n\n    @Override public int compareTo(Rectangle o) { return Double.compare(getArea(), o.getArea()); }\n}",
